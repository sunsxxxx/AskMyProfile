# Application
APP_ENV=production
LOG_LEVEL=INFO

# OpenAI-compatible chat model (required)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-tool-calling-model
# Leave empty unless your provider explicitly requires this parameter.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60

# DashScope embedding service (required)
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3

# Redis
# Docker Compose overrides this with redis://redis:6379 for the backend container.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_INDEX_NAME=interview_knowledge

# GitHub integration (optional)
GITHUB_USERNAME=your-github-username
# Optional for public repositories; use a read-only fine-grained token if configured.
GITHUB_TOKEN=
GITHUB_CACHE_TTL=600
GITHUB_TIMEOUT_SECONDS=10

# Web and proxy settings
# For production, replace this with the exact public origin, for example:
# FRONTEND_ORIGIN=https://interview.example.com
FRONTEND_ORIGIN=http://localhost:8080
# Comma-separated trusted proxy IPs or CIDR ranges. Keep empty for direct local runs.
TRUSTED_PROXIES=

# Rate limiting and request limits
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_TTL_SECONDS=90
MAX_MESSAGE_LENGTH=2000
RETRIEVER_TOP_K=5
